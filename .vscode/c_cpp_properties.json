                "${env:HOME}/haiku-sdk/boot/system/develop/headers/os/storage",
                "${env:HOME}/haiku-sdk/boot/system/develop/headers/os/support",
                "${env:HOME}/haiku-sdk/boot/system/develop/headers/os/translation",

                "${env:HOME}/haiku-sdk/boot/system/develop/headers/os/add-ons/graphics",
