                "${env:HOME}/haiku-sdk/boot/system/develop/headers/bsd",
                "${env:HOME}/haiku-sdk/boot/system/develop/headers/glibc",
                "${env:HOME}/haiku-sdk/boot/system/develop/headers/gnu",
                "${env:HOME}/haiku-sdk/boot/system/develop/headers/posix",
                "${env:HOME}/haiku-sdk/boot/system/develop/headers"
